[MENU]
MENUITEM=WIN, Windows 98SE GUI
MENUITEM=DOS_0, Basic DOS Mode
MENUITEM=DOS_1_SBEMU, SBEMU - Sound Blaster Emulation on Intel High Definition Audio
MENUITEM=DOS_2_NET_INTEL, Intel I-219 1GbE (E1000 NDIS2)
MENUITEM=DOS_3_SBEMU_INTEL, SBEMU + Intel I-219

MENUDEFAULT=WIN,3

[COMMON]
FILES=40
STACKS=9,256
LASTDRIVE=J
rem DEVICE=C:\WINDOWS\COMMAND\ANSI.SYS

[WIN]
DEVICE=C:\WINDOWS\HIMEM.SYS /M:1 /V
DOS=HIGH,UMB

[DOS_0]

[DOS_1_SBEMU]
DEVICE=C:\DATA\DOSDRIV\JEMMB585\JEMMEX.EXE NOEMS
DOS=HIGH,UMB,NOAUTO

[DOS_2_NET_INTEL]
DEVICE=C:\WINDOWS\HIMEM.SYS /M:1 /V
DOS=HIGH,UMB,NOAUTO
DEVICE=C:\DATA\DOSDRIV\PROTMAN\PROTMAN.DOS /I:C:\DATA\DOSDRIV\PRODOS
DEVICE=C:\DATA\DOSDRIV\PRODOS\E1000.DOS
DEVICE=C:\DATA\DOSDRIV\DISPKT11\DIS_PKT.DOS

[DOS_3_SBEMU_INTEL]
DEVICE=C:\DATA\DOSDRIV\JEMMB585\JEMMEX.EXE NOEMS
DOS=HIGH,UMB,NOAUTO
DEVICE=C:\DATA\DOSDRIV\PROTMAN\PROTMAN.DOS  /I:C:\DATA\DOSDRIV\PRODOS
DEVICE=C:\DATA\DOSDRIV\PRODOS\E1000.DOS
DEVICE=C:\DATA\DOSDRIV\DISPKT11\DIS_PKT.DOS
