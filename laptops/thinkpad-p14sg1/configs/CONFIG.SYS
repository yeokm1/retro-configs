[MENU]
MENUITEM=WIN, Windows 98SE GUI
MENUITEM=DOS_0, Basic DOS Mode
MENUITEM=DOS_1_SBEMU, SBEMU - Sound Blaster Emulation on Intel High Definition Audio
MENUITEM=DOS_2_NET_INTELTB, Intel I-210 1GbE via Thunderbolt 3 (E1000 NDIS2)
MENUITEM=DOS_3_SBEMU_Intel, SBEMU + Intel I-210 TB3 Ethernet
MENUITEM=DOS_4_NET_BCM57TB, Apple Thunderbolt 2 1GbE (BCM57 NDIS2)
MENUITEM=DOS_5_SBEMU_BCM57, SBEMU + Apple TB2 Ethernet
MENUITEM=DOS_6_NET_RTL8125, Realtek 8125 2.5GbE via Thunderbolt 3 (RTL25GND NDIS2)
MENUITEM=DOS_7_SBEMU_RTL8125, SBEMU + Realtek 8125 TB3 Ethernet

MENUDEFAULT=WIN,3

[COMMON]
FILES=40
STACKS=9,256
LASTDRIVE=J
rem DEVICE=C:\WINDOWS\COMMAND\ANSI.SYS

[WIN]
DEVICE=C:\WINDOWS\HIMEM.SYS /M:1 /V
DOS=HIGH,UMB

[DOS_0]

[DOS_1_SBEMU]
DEVICE=C:\DATA\DOSDRIV\JEMMB585\JEMMEX.EXE NOEMS
DOS=HIGH,UMB,NOAUTO

[DOS_2_NET_INTELTB]
DEVICE=C:\WINDOWS\HIMEM.SYS /M:1 /V
DOS=HIGH,UMB,NOAUTO
DEVICE=C:\DATA\DOSDRIV\PROTMAN\PROTMAN.DOS /I:C:\DATA\DOSDRIV\PRODOS
DEVICE=C:\DATA\DOSDRIV\PRODOS\E1000.DOS
DEVICE=C:\DATA\DOSDRIV\DISPKT11\DIS_PKT.DOS

[DOS_3_SBEMU_Intel]
DEVICE=C:\DATA\DOSDRIV\JEMMB585\JEMMEX.EXE NOEMS
DOS=HIGH,UMB,NOAUTO
DEVICE=C:\DATA\DOSDRIV\PROTMAN\PROTMAN.DOS  /I:C:\DATA\DOSDRIV\PRODOS
DEVICE=C:\DATA\DOSDRIV\PRODOS\E1000.DOS
DEVICE=C:\DATA\DOSDRIV\DISPKT11\DIS_PKT.DOS

[DOS_4_NET_BCM57TB]
DEVICE=C:\WINDOWS\HIMEM.SYS /M:1 /V
DOS=HIGH,UMB,NOAUTO
DEVICE=C:\DATA\DOSDRIV\PROTMAN\PROTMAN.DOS /I:C:\DATA\DOSDRIV\BCM-NDIS
DEVICE=C:\DATA\DOSDRIV\BCM-NDIS\B57.DOS
DEVICE=C:\DATA\DOSDRIV\DISPKT11\DIS_PKT.DOS

[DOS_5_SBEMU_BCM57]
DEVICE=C:\DATA\DOSDRIV\JEMMB585\JEMMEX.EXE NOEMS
DOS=HIGH,UMB,NOAUTO
DEVICE=C:\DATA\DOSDRIV\PROTMAN\PROTMAN.DOS /I:C:\DATA\DOSDRIV\BCM-NDIS
DEVICE=C:\DATA\DOSDRIV\BCM-NDIS\B57.DOS
DEVICE=C:\DATA\DOSDRIV\DISPKT11\DIS_PKT.DOS

[DOS_6_NET_RTL8125]
DEVICE=C:\WINDOWS\HIMEM.SYS /M:1 /V
DOS=HIGH,UMB,NOAUTO
DEVICE=C:\DATA\DOSDRIV\PROTMAN\PROTMAN.DOS /I:C:\DATA\DOSDRIV\RTL8125
DEVICE=C:\DATA\DOSDRIV\RTL8125\RT25GND.DOS
DEVICE=C:\DATA\DOSDRIV\DISPKT11\DIS_PKT.DOS

[DOS_7_SBEMU_RTL8125]
DEVICE=C:\DATA\DOSDRIV\JEMMB585\JEMMEX.EXE NOEMS
DOS=HIGH,UMB,NOAUTO
DEVICE=C:\DATA\DOSDRIV\PROTMAN\PROTMAN.DOS /I:C:\DATA\DOSDRIV\RTL8125
DEVICE=C:\DATA\DOSDRIV\RTL8125\RT25GND.DOS
DEVICE=C:\DATA\DOSDRIV\DISPKT11\DIS_PKT.DOS
