@ECHO OFF
SET TEMP=C:\TEMP
SET TMP=C:\TMP
SET DIRCMD=/O:GEN/P/A
LH C:\DATA\DOSDRIV\DOSKEY28\DOSKEY.COM
C:\DATA\DOSDRIV\CTMS21B4\BIN\CTMOUSE.EXE /3
LH C:\DATA\DOSDRIV\SHCDX309\SHSUCDX.COM /D:MYCD,D
PATH C:\WINDOWS
PROMPT $V$_$D $T$_$p$g
GOTO %CONFIG%

:WIN
win
GOTO END

:DOS_BAS
C:\DATA\DOSDRIV\DOSID251\DOSIDLE.EXE
GOTO END

:DOS_VSB
SET BLASTER=A220 I5 D1 H5 T6 P330
C:\DATA\DOSDRIV\JEMMB586\JLOAD.EXE -q C:\DATA\DOSDRIV\VSBHDA19\QPIEMU.DLL
C:\DATA\DOSDRIV\JEMMB586\JLOAD.EXE -q C:\DATA\DOSDRIV\VSBHDA19\JHDPMI.DLL
LH C:\DATA\DOSDRIV\VSBHDA19\HDPMI32I -x2
C:\DATA\DOSDRIV\VSBHDA19\VSBHDA.EXE /O1 /VOL8
C:\DATA\DOSDRIV\DOSID251\DOSIDLE.EXE
GOTO END

:DOS_NET
PATH C:\DATA\DOSDRIV\MTCP2025;%PATH%
LH C:\DATA\DOSDRIV\PRO1000\LSL.COM /C=C:\NET.CFG
LH C:\DATA\DOSDRIV\PRO1000\E1000ODI.COM
LH C:\DATA\DOSDRIV\ODIPKT31\ODIPKT.COM 0 96
SET MTCPCFG=C:\MTCP.CFG
SET TZ=UTC-8
C:\DATA\DOSDRIV\DOSID251\DOSIDLE.EXE
rem dhcp
rem sntp -set sg.pool.ntp.org
GOTO END

:DOS_BOTH
SET BLASTER=A220 I5 D1 H5 T6 P330
C:\DATA\DOSDRIV\JEMMB586\JLOAD.EXE -q C:\DATA\DOSDRIV\VSBHDA19\QPIEMU.DLL
C:\DATA\DOSDRIV\JEMMB586\JLOAD.EXE -q C:\DATA\DOSDRIV\VSBHDA19\JHDPMI.DLL
LH C:\DATA\DOSDRIV\VSBHDA19\HDPMI32I -x2
C:\DATA\DOSDRIV\VSBHDA19\VSBHDA.EXE /O1 /VOL8
PATH C:\DATA\DOSDRIV\MTCP2025;%PATH%
LH C:\DATA\DOSDRIV\PRO1000\LSL.COM /C=C:\NET.CFG
LH C:\DATA\DOSDRIV\PRO1000\E1000ODI.COM
LH C:\DATA\DOSDRIV\ODIPKT31\ODIPKT.COM 0 96
SET MTCPCFG=C:\MTCP.CFG
SET TZ=UTC-8
C:\DATA\DOSDRIV\DOSID251\DOSIDLE.EXE
rem dhcp
rem sntp -set sg.pool.ntp.org
GOTO END

:END
