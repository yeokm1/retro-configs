[Version]
CatalogFile =DualParu.cat
Signature=$Windows NT$
Provider=Matrox Graphics Inc.
ClassGuid={4d36e968-e325-11ce-bfc1-08002be10318}
Class=Display
DriverVer=06/19/2006, 1.12.0.110

[VHead]
Supported = 0527, 0528, 2537,2538
Unsupported = 0528-14A1102B, 0528-1471102B, 0528-1441102B,0528-1521102B,0528-1531102B, 0528-2021102B,0528-2031102B,2537-1C10102B,2537-1C20102B, 2537-2C11102B, 2537-2C21102B, 2537-2C31102B,2537-2C41102B,2537-2811102B,2537-2821102B,2537-3001102B,2537-3061102B,2538-30C7102B,2538-3007102B,2538-1047102B
NoIndependentPrompt = 0528-2011102B,0528-2021102B,2537-1C10102B,2537-2C11102B,2537-2C21102B,2537-2C31102B,2537-2C41102B,2538-30C7102B,2538-3007102B,2538-3047102B,2538-3087102B

[SourceDisksNames]
1 = %Disk1%,Unified.cab

[SourceDisksFiles]
mtxparhm.sys = 1
mtxparhd.dll = 1

[DestinationDirs]
DefaultDestDir = 11
Miniport.MTXPARVH  = 12

[Manufacturer]
Matrox=Mfg.Matrox

[Mfg.Matrox]
Matrox Parhelia/P650/P750 Series DualHead=MTXPARVH

[MTXPARVH]
AddReg=AddReg.Setup.MTXPARVH
CopyFiles=Driver.MTXPARVH, Miniport.MTXPARVH

[AddReg.Setup.MTXPARVH]
HKR,Settings,InstalledDisplayDrivers,0x00010000,MTXPARHD
HKR,Settings,VgaCompatible,0x00010001,0

[Miniport.MTXPARVH]
mtxparhm.sys,,,0x00000004

[Driver.MTXPARVH]
mtxparhd.dll,,,0x00000004

[MTXPARVH.Services]
AddService = MTXPARH, 0x00000002, MTXPARVH_Service_Inst, MTXPARVH_EventLog_Inst

[MTXPARVH_Service_Inst]
ServiceType    = 0x00000001
StartType      = 3
ErrorControl   = 0
ServiceBinary  = %12%\mtxparhm.sys
LoadOrderGroup = Video

[MTXPARVH_EventLog_Inst]
AddReg = MTXPARVH_EventLog_AddReg

[MTXPARVH_EventLog_AddReg]
HKR,,EventMessageFile,0x00020000,"%SystemRoot%\System32\IoLogMsg.dll;%SystemRoot%\System32\drivers\mtxparhm.sys"
HKR,,TypesSupported,0x00010001,7

[Strings]
REG_SZ        = 0x00000000
REG_MULTI_SZ  = 0x00010000
REG_EXPAND_SZ = 0x00020000
REG_BINARY    = 0x00000001
REG_DWORD     = 0x00010001
SERVICEROOT   = System\CurrentControlSet\Services
GenuineMatroxMGIPackage = 0x00000001
